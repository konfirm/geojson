{
	"name": "@konfirm/geojson",
	"version": "1.0.0",
	"description": "GeoJSON implementation",
	"main": "dist/main.js",
	"module": "dist/main.mjs",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"types": "./dist/main.d.ts",
			"import": "./dist/main.mjs",
			"require": "./dist/main.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/konfirm/geojson.git"
	},
	"bugs": {
		"url": "https://github.com/konfirm/geojson/issues"
	},
	"scripts": {
		"test": "run-script-os",
		"test:nix": "TS_NODE_PROJECT=tsconfig.test.json ts-node node_modules/tape/bin/tape 'test/**/*.ts'",
		"test:win32": "TS_NODE_PROJECT=tsconfig.test.json ts-node node_modules/tape/bin/tape test/**/*.ts",
		"test:coverage": "run-script-os",
		"test:coverage:nix": "TS_NODE_PROJECT=tsconfig.test.json nyc --reporter=html --require ts-node/register tape 'test/**/*.ts' | tap-arc",
		"test:coverage:win32": "TS_NODE_PROJECT=tsconfig.test.json nyc --reporter=html --require ts-node/register tape test/**/*.ts | tap-arc",
		"test:pretty": "run-script-os",
		"test:pretty:nix": "TS_NODE_PROJECT=tsconfig.test.json nyc --require ts-node/register tape 'test/**/*.ts' | tap-arc",
		"test:pretty:win32": "TS_NODE_PROJECT=tsconfig.test.json nyc --require ts-node/register tape test/**/*.ts | tap-arc",
		"build": "tsup",
		"lint": "biome lint",
		"format": "biome format",
		"check": "biome check",
		"check:write": "biome check --write",
		"prepublish": "npm run build"
	},
	"keywords": [
		"geojson"
	],
	"author": "Rogier Spieker <rogier+npm@konfirm.eu>",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@types/tape": "^4.13.2",
		"nyc": "^15.1.0",
		"run-script-os": "^1.1.6",
		"tap-arc": "^0.3.5",
		"tape": "^5.6.3",
		"template-literal-each": "^3.0.0",
		"ts-node": "^10.9.1",
		"tslib": "^2.5.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.0"
	},
	"dependencies": {
		"@konfirm/guard": "^2.0.0"
	}
}
